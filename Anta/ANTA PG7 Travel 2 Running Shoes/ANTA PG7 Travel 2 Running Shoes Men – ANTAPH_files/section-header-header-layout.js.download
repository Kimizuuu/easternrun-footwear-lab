document.addEventListener("DOMContentLoaded", () => {
    async function loadProductsForCollection(col) {
        if (!col || col.dataset.loaded === "true" || col.dataset.loading === "true") return;

        const grid = col.querySelector(".collection-products-grid");
        if (!grid) return;

        col.dataset.loading = "true";

        try {
            const response = await fetch(col.dataset.url);
            const htmlText = await response.text();
            const doc = new DOMParser().parseFromString(htmlText, "text/html");
            const products = Array.from(
                doc.querySelectorAll(".product-block")
            ).slice(0, 4);

            if (!products.length) {
                grid.innerHTML = '<p class="no-product-msg">No products found.</p>';
                col.dataset.loaded = "true";
                return;
            }

            grid.innerHTML = products.map(product => {
                const link = product.querySelector("a")?.getAttribute("href") || "#";
                const title = product.querySelector(".product__title, h3, h2")?.textContent.trim() || "Product";
                const images = product.querySelectorAll(".card__media img");
                const img1 = images[0]?.src || "";
                const img2 = images[1]?.src || img1;
                const type = product.querySelector(".product-type, .type")?.textContent.trim() || "";
                const regPrice = product.querySelector(".price-position-sale, .price-item")?.textContent.trim() || "";
                const compPrice = product.querySelector(".price-position-origin")?.textContent.trim() || "";
                const tagContent = product.querySelector(".product-data-tag-single")?.textContent.trim() || "";

                return `
                    <div class="custom-product-card-items">
                        <a href="${link}">
                            <div class="product-card-img-wrapper">
                                <img class="img-default" src="${img1}" alt="${title}" loading="lazy">
                                <img class="img-hover" src="${img2}" alt="${title}" loading="lazy">
                            </div>
                            <div class="custom-product-info-items">
                                <h3 class="product--card-ttl">${title}</h3>
                                ${type ? `<span class="product-card-type-main">${type}</span>` : ""}
                                <div class="product-price-both-items">
                                    <div class="product-price-regular">${regPrice}</div>
                                    ${compPrice ? `<div class="product-price-compare-prie">${compPrice}</div>` : ""}
                                </div>
                            </div>
                        </a>
                        ${tagContent ? `<div class="megamenu-data-tag-single">${tagContent}</div>` : ""}
                    </div>
                `;
            }).join("");

            col.dataset.loaded = "true";
        } catch (e) {
            grid.innerHTML = "<p>Products failed to load.</p>";
        } finally {
            col.dataset.loading = "false";
        }
    }

    document.querySelectorAll(".menu_accordian-items-main").forEach(container => {
        const viewAllBtn = container.querySelector(".all-menu-btn-links");
        const defaultActive =
            container.querySelector(".header-accordian-childmenu-menu.active") ||
            container.querySelector(".header-accordian-items-menu.active");

        if (defaultActive) {
            const targetTab = defaultActive.dataset.tab;
            const activeText = defaultActive.textContent.trim();

            const activeCollection = container.querySelector(
                `.collection-products[data-tab="${targetTab}"]`
            );

            if (activeCollection) {
                activeCollection.classList.add("active"); // Ensure explicit visual activation
                loadProductsForCollection(activeCollection);
            }

            if (viewAllBtn && activeCollection) {
                viewAllBtn.textContent = `View All ${activeText}`;
                viewAllBtn.setAttribute("href", activeCollection.dataset.url || "#");
            }
        }
        container.addEventListener("click", (e) => {
            const parentLink = e.target.closest(".header-accordian-items-menu");
            const childLink = e.target.closest(".header-accordian-childmenu-menu");
            if (parentLink) {
                e.preventDefault();
                const targetTab = parentLink.dataset.tab;
                const activeText = parentLink.childNodes[0].textContent.trim();

                container.querySelectorAll(".header-accordian-items-menu").forEach(link => link.classList.remove("active"));
                parentLink.classList.add("active");

                container.querySelectorAll(".header-dropdown-menu-innerlinks").forEach(drop => drop.style.display = "none");

                const innerMenu = parentLink.parentElement.querySelector(".header-dropdown-menu-innerlinks");
                if (innerMenu) {
                    innerMenu.style.display = "block";
                    const firstChild = innerMenu.querySelector(".header-accordian-childmenu-menu");
                    if (firstChild) {
                        firstChild.click();
                        return;
                    }
                }
                switchActiveCollection(targetTab, activeText);
            }
            if (childLink) {
                e.preventDefault();
                const targetTab = childLink.dataset.tab;
                const activeText = childLink.textContent.trim();

                container.querySelectorAll(".header-accordian-childmenu-menu").forEach(link => link.classList.remove("active"));
                childLink.classList.add("active");

                switchActiveCollection(targetTab, activeText);
            }
        });
        function switchActiveCollection(tabId, text) {
            container.querySelectorAll(".collection-products").forEach(content => {
                content.classList.remove("active");
            });

            const targetCollection = container.querySelector(`.collection-products[data-tab="${tabId}"]`);
            if (targetCollection) {
                targetCollection.classList.add("active");
                loadProductsForCollection(targetCollection); // Will skip network request instantly if preloaded

                if (viewAllBtn) {
                    viewAllBtn.textContent = `View All ${text}`;
                    viewAllBtn.setAttribute("href", targetCollection.dataset.url || "#");
                }
            }
        }
    });
    const preloadAllRemaining = async () => {
        const allCollections = Array.from(document.querySelectorAll(".collection-products"));
        for (const col of allCollections) {
            if (col.dataset.loaded === "true" || col.dataset.loading === "true") continue;
            await loadProductsForCollection(col);
        }
    };

    setTimeout(preloadAllRemaining, 600);
});

document.querySelectorAll(".menu_accordian-items-main").forEach(container => {
    const firstVisibleDropdown = container.querySelector(".header-dropdown-menu-innerlinks[style*='block']");
    if (firstVisibleDropdown) {
        const firstChild = firstVisibleDropdown.querySelector(".header-accordian-childmenu-menu");
        if (firstChild) {
            container.querySelectorAll(".header-accordian-childmenu-menu").forEach(el => {
                el.classList.remove("active");
            });
            firstChild.classList.add("active");
            const tab = firstChild.dataset.tab;
            const activeCollection = container.querySelector(`.collection-products[data-tab="${tab}"]`);
            container.querySelectorAll(".collection-products").forEach(el => {
                el.classList.remove("active");
            });
            activeCollection?.classList.add("active");
        }
    }

});