.image-with-text-content {
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
}

.img-txt-cont-banner {
  position: relative;
  display: flex;
  align-items: center;
  margin: 30px 0 0 0;
}

.banner-bg img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.image-with-text-content.is-visible .block-banner-content {
  transform: translateY(0);
}

.block-banner-content {
  position: relative;
  color: var(--color);
  padding: 40px 100px;
  transition: all .6s;
  transform: translateY(100px);
}

.img-txt-cont-banner a {
  color: var(--color);
  background: var(--bg);
}

.image-text-content-header h2 {
  color: var(--color);
  font-size: var(--font);
  text-align: center;
}

.image-text-content-header p {
  margin: 12px 0 0 0;
  text-align: center;
  font-size: var(--font);
}

.block-banner-content h2 {
  font-size: 36px;
  text-transform: capitalize;
}

.block-banner-content p {
  font-size: 18px;
  max-width: 475px;
}

a.block-banner-btn {
  display: flex;
  line-height: 1.2;
  width: 146px;
  font-size: 20px;
  color: var(--color);
  background: var(--bg);
  align-items: center;
  justify-content: center;
  position: relative;
  text-transform: capitalize;
  padding: 10px;
  border-radius: 30px;
  transition: 0.5s;
  overflow: hidden;
  margin: 0 0px 0px;
  border: 1px solid var(--bg);
}

a.block-banner-btn span.top-text {
  transform: translateY(0%);
  transition: all 0.3s ease;
}

a.block-banner-btn span.bottom-text {
  position: absolute;
  transform: translateY(200%);
  transition: all 0.3s ease;
}

a.block-banner-btn:hover span.top-text {
  transform: translateY(-200%);
  transition: all 0.3s ease;
}

a.block-banner-btn:hover span.bottom-text {
  transform: translateY(0%);
  transition: all 0.3s ease;
  color: #000000;
}

.banner-bg img.mobile-only-image {
  display: none;
}

.image-with-text-content.center-text .block-banner-content {
  text-align: center;
}

.image-with-text-content.center-text a.block-banner-btn {
  margin: 0 auto;
}

.image-with-text-content.center-text .img-txt-cont-banner {
  justify-content: center;
}

.image-with-text-content.center-text .block-banner-content h2 {
  font-size: 40px;
}

.image-with-text-content.center-text .block-banner-content p {
  font-size: 16px;
}

.custom-center-txt .img-txt-cont-banner {
  justify-content: center;
}

.custom-center-txt .block-banner-content h2 {
  font-size: 44px;
  text-align: center;
}

.custom-center-txt .block-banner-content p {
  text-align: center;
  font-size: 16px;
  max-width: 100%;
}

.custom-center-txt a.block-banner-btn {
  margin: 0 auto;
}

@media (max-width:749px) {
  .image-text-content-header h2 {
    font-size: var(--font-mobile);
  }

  .image-text-content-header p {
    font-size: var(--font-mobile);
    margin: 8px 0 0 0;
  }

  .block-banner-content {
    padding: 22px 20px;
  }

  .banner-bg img.mobile-only-image {
    display: block;
  }

  .banner-bg img.desktop-only-image {
    display: none;
  }

  .block-banner-content h2 {
    font-size: 22px;
    text-align: left;
  }

  .block-banner-content p {
    font-size: 14px;
    max-width: 475px;
    margin: 4px 0 12px 0;
    text-align: left;
  }

  a.block-banner-btn {
    width: 84px;
    font-size: 14px;
    padding: 6px;
  }

  .img-txt-cont-banner {
    align-items: flex-start;
    margin: 20px 0 0 0;
    aspect-ratio: 1/1;
  }

  .image-with-text-content {
    padding-top: var(--padding-top-mobile);
    padding-bottom: var(--padding-bottom-mobile);
  }

  .image-with-text-content.center-text .img-txt-cont-banner {
    align-items: center;
  }

  .image-with-text-content.center-text .block-banner-content h2 {
    text-align: center;
    font-size: 24px;
  }

  .image-with-text-content.center-text .block-banner-content p {
    text-align: center;
  }

  .image-with-text-content.center-text .block-banner-content p,
  .custom-center-txt .block-banner-content p {
    font-size: 14px;
  }

  .custom-center-txt .block-banner-content h2 {
    font-size: 24px;
  }


  .custom-center-txt .img-txt-cont-banner {
    align-items: center;
  }
}